# ─────────────────────────────────────────────────────────────────────────
# ushanr — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────

# Application
APP_NAME=ushanr
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-please-use-a-strong-random-key

# Server
HOST=0.0.0.0
PORT=8007
WORKERS=2

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5432/ushanr
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Base URL path (for reverse proxy / nginx prefix)
USHANR_BASE_PATH=/uanr

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=["*"]

# Rate limiting
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60

# Pagination defaults
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=200

# Accounting defaults
DEFAULT_CURRENCY=KWD
DEFAULT_DECIMAL_PLACES=3
