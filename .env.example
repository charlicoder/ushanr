# ─────────────────────────────────────────────────────────────────────────
# ushanr — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────

# Application
APP_NAME=ushanr
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=INFO
# JWT verification key — MUST be identical to ushauth's JWT_SECRET_KEY
# (or DJANGO_SECRET_KEY if ushauth has no JWT_SECRET_KEY). Accepted names:
# JWT_SECRET_KEY (preferred) > SECRET_KEY > DJANGO_SECRET_KEY
JWT_SECRET_KEY=change-me-in-production

# Server
HOST=0.0.0.0
PORT=8007
WORKERS=2

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5432/ushanr
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Base URL path (for reverse proxy / nginx prefix)
USHANR_BASE_PATH=/uanr

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=["*"]

# ─────────────────────────────────────────────────────────────────────────
# RBAC / Inter-service Authorization
# ─────────────────────────────────────────────────────────────────────────
# URL of the ushauth service — used to fetch employee permissions on each
# request (result is cached in-process for RBAC_CODENAME_CACHE_TTL_SECONDS).
USHAUTH_BASE_URL=http://ushauth:8000

# Pre-shared application token — must match USHSPA_TOKEN configured in
# ushauth.  Required for all inter-service API calls.
USHSPA_TOKEN=change-me-strong-random-token

# How long (seconds) to cache employee permission codenames in-process.
# Shorter values reduce the window during which revoked permissions remain
# effective; longer values reduce load on ushauth.  Default: 300 (5 min).
RBAC_CODENAME_CACHE_TTL_SECONDS=300

# Rate limiting
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60

# Pagination defaults
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=200

# Accounting defaults
DEFAULT_CURRENCY=KWD
DEFAULT_DECIMAL_PLACES=3
